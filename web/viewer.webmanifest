{
  "name": "Onboard Viewer",
  "short_name": "Viewer",
  "description": "Content-only viewer for Onboard.",
  "author": {
    "name": "Pablo"
  },
  "scope": "/",
  "start_url": "/viewer",
  "display": "standalone",
  "background_color": "#172033",
